# Go development tasks

set shell := ["fish", "-c"]

default:
    @just --list

# ───── Project init ─────

# Initialise a Go module (usage: just init github.com/user/repo)
init MODULE:
    go mod init {{MODULE}}

# Sync / tidy dependencies
deps:
    go mod tidy

# Download all dependencies
download:
    go mod download

# Show why a package is needed
why PKG:
    go mod why {{PKG}}

# Upgrade all direct dependencies
update:
    go get -u ./...
    go mod tidy

# ───── Build / Run ─────

# Build all packages
build:
    go build ./...

# Build the main package as ./bin/<modname>
build-bin:
    mkdir -p bin
    go build -o bin/$(basename $(go list -m)) ./...

# Build release binary (stripped, no debug info)
release:
    mkdir -p bin
    go build -ldflags="-s -w" -trimpath -o bin/$(basename $(go list -m)) ./...

# Run the main package
run:
    go run ./...

# Run with arguments
run-args *ARGS:
    go run ./... {{ARGS}}

# ───── Test / Lint / Format ─────

# Run all tests
test:
    go test ./...

# Run tests with verbose output
test-verbose:
    go test -v ./...

# Run tests with race detector
test-race:
    go test -race ./...

# Run tests with coverage
test-cov:
    go test -cover -coverprofile=coverage.out ./...
    go tool cover -html=coverage.out -o coverage.html

# Run specific test
test-match PATTERN:
    go test -run {{PATTERN}} -v ./...

# Benchmark
bench:
    go test -bench=. -benchmem ./...

# Format all sources
fmt:
    gofmt -w .
    goimports -w .

# Check formatting (CI)
fmt-check:
    test -z "$(gofmt -l .)"

# Run staticcheck + go vet
lint:
    go vet ./...
    staticcheck ./...
    golangci-lint run

# Full CI pipeline
check: fmt-check lint test
    @echo "✓ All checks passed!"

# Clean build artifacts and caches
clean:
    rm -rf bin/ coverage.out coverage.html

# ───── NixOS VM ─────

# Build the NixOS dev VM (mounts project at /home/dev/project)
vm-build:
    nix build .#nixosConfigurations.dev-vm.config.system.build.vm

# Build and start the dev VM (Ctrl-A x to exit nographic console)
vm: vm-build
    ./result/bin/run-dev-vm-vm -nographic

# SSH into the running dev VM
vm-ssh:
    ssh -p 2222 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null dev@localhost
